# Copy to terraform.tfvars and fill in. Only project_id is required.

# ── GCP ───────────────────────────────────────────────────────────────────────
project_id = "your-gcp-project-id"
region     = "us-central1"

# ── Firebase Authentication ─────────────────────────────────────────────────
# From the Firebase console's project settings, once Firebase is added to this
# GCP project. Not secret - these are public client-side identifiers.
firebase_api_key    = "AIzaSy..."
firebase_project_id = "your-gcp-project-id"

# ── Scheduled sync (Phase 1 of the multi-tenant conversion: one designated
#    tenant/environment, not yet a fan-out across every tenant) ─────────────
# Leave both empty to disable the scheduled job until you've onboarded a
# tenant/environment through the app and copied its IDs here.
# scheduled_sync_tenant_id      = ""
# scheduled_sync_environment_id = ""
initial_cron_expression = "0 2 * * *"   # UTC

# ── GitHub (Workload Identity Federation) ───────────────────────────────────
# Leave "" to skip creating WIF resources.
github_repo = "my-org/gemini-enterprise-manager"

# ── Optional resource names (defaults shown; override only if you must) ──────
# service_name                = "gemini-license-provisioner"
# app_service_account_id       = "sa-gemini-provisioner"
# scheduler_service_account_id = "sa-scheduler-invoker"
# artifact_repository_id       = "gemini-provisioner-docker"
# scheduler_job_name           = "gemini-license-sync-job"     # the cron trigger
# sync_job_name                = "gemini-license-sync-runner"  # the Cloud Run job it executes
